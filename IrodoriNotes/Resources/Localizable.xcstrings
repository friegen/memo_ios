    "trash_delete_folder_empty_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” will be permanently deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se eliminará definitivamente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » sera supprimé définitivement. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” akan dihapus permanen. Tindakan ini tidak dapat diurungkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」を完全に削除します。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ 폴더가 영구 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” será excluída permanentemente. Essa ação não pode ser desfeita."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」將永久刪除，且無法復原。"
          }
        }
      }
    },
    "trash_delete_folder_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und sein Inhalt (%2$@) werden endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and its contents (%2$@) will be permanently deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» y su contenido (%2$@) se eliminarán definitivamente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et son contenu (%2$@) seront supprimés définitivement. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” beserta isinya (%2$@) akan dihapus permanen. Tindakan ini tidak dapat diurungkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」と中身（%2$@）を完全に削除します。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ 폴더와 그 안의 항목(%2$@)이 영구 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e o conteúdo dela (%2$@) serão excluídos permanentemente. Essa ação não pode ser desfeita."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」及其中的內容（%2$@）將永久刪除，且無法復原。"
          }
        }
      }
    },
