    "folder_delete_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und sein Inhalt (%2$@) werden in den Papierkorb verschoben. Du kannst sie 30 Tage lang wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and its contents (%2$@) will be moved to the trash. You can restore them within 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» y su contenido (%2$@) se moverán a la papelera. Puedes restaurarlos durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » et son contenu (%2$@) seront placés dans la corbeille. Vous pourrez les restaurer pendant 30 jours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” beserta isinya (%2$@) akan dipindahkan ke sampah. Anda dapat memulihkannya dalam 30 hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」と中身（%2$@）をゴミ箱に移動します。30日以内なら元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’ 폴더와 그 안의 항목(%2$@)이 휴지통으로 이동합니다. 30일 이내에 복원할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e o conteúdo dela (%2$@) serão movidos para a lixeira. Você pode restaurá-los em até 30 dias."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」及其中的內容（%2$@）會移至垃圾桶，30 天內可以還原。"
          }
        }
      }
    },
