    "settings_sample_text": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einkaufsliste\n- Milch\n- Eier\nMorgen um 10 Uhr Besprechung. Unterlagen am Vorabend ausdrucken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shopping list\n- Milk\n- Eggs\nMeeting at 10 tomorrow. Print the handouts the night before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de la compra\n- Leche\n- Huevos\nReunión mañana a las 10. Imprimir los documentos la noche anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste de courses\n- Lait\n- Œufs\nRéunion demain à 10 h. Imprimer les documents la veille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar belanja\n- Susu\n- Telur\nRapat besok pukul 10. Cetak bahan malam sebelumnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の買い物\n・牛乳\n・卵\n明日は10時から打ち合わせ。資料は前日に印刷しておく。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장보기 목록\n- 우유\n- 달걀\n내일 10시 회의. 자료는 전날 밤에 인쇄하기."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista de compras\n- Leite\n- Ovos\nReunião amanhã às 10. Imprimir os materiais na noite anterior."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購物清單\n- 牛奶\n- 雞蛋\n明天 10 點開會。前一晚先把資料印好。"
          }
        }
      }
    },
