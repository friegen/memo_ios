    "editor_empty_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz löschen? Sie wird in den Papierkorb verschoben und kann dort 30 Tage lang wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this note? It will be moved to the trash, where you can restore it within 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar esta nota? Se moverá a la papelera, donde podrás restaurarla durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette note ? Elle sera placée dans la corbeille, où vous pourrez la restaurer pendant 30 jours."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus catatan ini? Catatan akan dipindahkan ke sampah dan dapat dipulihkan dalam 30 hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモを削除しますか？\nゴミ箱に移動し、30日以内なら元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모를 삭제할까요? 휴지통으로 이동하며 30일 이내에 복원할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir esta nota? Ela será movida para a lixeira, onde você pode restaurá-la em até 30 dias."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除這則記事嗎？記事會移至垃圾桶，30 天內可以還原。"
          }
        }
      }
    },
