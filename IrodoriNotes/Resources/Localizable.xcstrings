    "trash_restore_folder_with_parent_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der übergeordnete Ordner ist ebenfalls im Papierkorb. Damit dieser Ordner an seinen ursprünglichen Ort zurückkehrt, wird auch der übergeordnete Ordner wiederhergestellt – zusammen mit den Elementen, die mit ihm gelöscht wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parent folder is also in the trash. To put this folder back where it was, the parent folder will be restored too, along with the items that were deleted with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta superior también está en la papelera. Para devolver esta carpeta a su lugar, también se restaurará la carpeta superior, junto con los elementos que se eliminaron con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier parent est aussi dans la corbeille. Pour remettre ce dossier à sa place, le dossier parent sera également restauré, ainsi que les éléments supprimés avec lui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder induk juga ada di sampah. Agar folder ini kembali ke tempat semula, folder induk juga akan dipulihkan, beserta item yang dihapus bersamanya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダが入っていたフォルダもゴミ箱にあります。元の場所に戻すため、上のフォルダも一緒に元に戻します（上のフォルダと一緒に削除したメモなども戻ります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상위 폴더도 휴지통에 있습니다. 이 폴더를 원래 위치로 되돌리기 위해 상위 폴더도 함께 복원되며, 상위 폴더와 함께 삭제된 항목도 복원됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta superior também está na lixeira. Para colocar esta pasta de volta no lugar, a pasta superior também será restaurada, junto com os itens excluídos com ela."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上層資料夾也在垃圾桶中。為了將這個資料夾放回原處，系統也會還原上層資料夾，以及與它一起刪除的項目。"
          }
        }
      }
    },
    "trash_restore_memo_with_folder_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner, in dem sich diese Notiz befand, ist ebenfalls im Papierkorb. Damit die Notiz an ihren ursprünglichen Ort zurückkehrt, wird auch der Ordner wiederhergestellt – zusammen mit den Elementen, die mit ihm gelöscht wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder this note was in is also in the trash. To put the note back where it was, the folder will be restored too, along with the items that were deleted with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta en la que estaba esta nota también está en la papelera. Para devolver la nota a su lugar, también se restaurará la carpeta, junto con los elementos que se eliminaron con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier qui contenait cette note est aussi dans la corbeille. Pour remettre la note à sa place, le dossier sera également restauré, ainsi que les éléments supprimés avec lui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder tempat catatan ini berada juga ada di sampah. Agar catatan kembali ke tempat semula, folder tersebut juga akan dipulihkan, beserta item yang dihapus bersamanya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモが入っていたフォルダもゴミ箱にあります。元の場所に戻すため、フォルダも一緒に元に戻します（フォルダと一緒に削除したメモなども戻ります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모가 있던 폴더도 휴지통에 있습니다. 메모를 원래 위치로 되돌리기 위해 폴더도 함께 복원되며, 폴더와 함께 삭제된 항목도 복원됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta em que esta nota estava também está na lixeira. Para colocar a nota de volta no lugar, a pasta também será restaurada, junto com os itens excluídos com ela."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則記事原本所在的資料夾也在垃圾桶中。為了將記事放回原處，系統也會還原該資料夾，以及與它一起刪除的項目。"
          }
        }
      }
    },
