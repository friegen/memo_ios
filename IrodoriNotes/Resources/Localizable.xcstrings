    "trash_empty_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles im Papierkorb wird endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the trash will be permanently deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay en la papelera se eliminará definitivamente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le contenu de la corbeille sera supprimé définitivement. Cette action est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang ada di sampah akan dihapus permanen. Tindakan ini tidak dapat diurungkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱の中身をすべて完全に削除します。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있는 모든 항목이 영구 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está na lixeira será excluído permanentemente. Essa ação não pode ser desfeita."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶中的所有項目都將永久刪除，且無法復原。"
          }
        }
      }
    },
