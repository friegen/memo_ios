      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Sperren zu verwenden, richte auf deinem iPhone unter Einstellungen > Face ID & Code (oder Touch ID & Code) einen Code ein. Danach kannst du auch mit Face ID oder Touch ID entsperren.\n\nGesperrte Notizen und Ordner werden nicht gelöscht. Du kannst sie wieder öffnen, sobald du einen Code eingerichtet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use locks, set a passcode on your iPhone in Settings > Face ID & Passcode (or Touch ID & Passcode). You can then also unlock with Face ID or Touch ID.\n\nLocked notes and folders aren’t deleted, and you can open them again after you set a passcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar los bloqueos, configura un código en tu iPhone en Ajustes > Face ID y código (o Touch ID y código). Después también podrás desbloquear con Face ID o Touch ID.\n\nLas notas y carpetas bloqueadas no se eliminan, y podrás abrirlas de nuevo cuando configures un código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser le verrouillage, définissez un code sur votre iPhone dans Réglages > Face ID et code (ou Touch ID et code). Vous pourrez ensuite aussi déverrouiller avec Face ID ou Touch ID.\n\nLes notes et dossiers verrouillés ne sont pas supprimés : vous pourrez les ouvrir à nouveau après avoir défini un code."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan kunci, atur kode sandi di iPhone Anda melalui Pengaturan > Face ID & Kode Sandi (atau Touch ID & Kode Sandi). Setelah itu, Anda juga dapat membuka kunci dengan Face ID atau Touch ID.\n\nCatatan dan folder yang terkunci tidak dihapus, dan Anda dapat membukanya lagi setelah mengatur kode sandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロックを使うには、設定アプリの「Face ID とパスコード」（または「Touch ID とパスコード」）で iPhone のパスコードを設定してください。Face ID や Touch ID での解除も使えるようになります。\n\nロックしたメモやフォルダは消えません。パスコードを設定し直せば開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 기능을 사용하려면 설정 > Face ID 및 암호(또는 Touch ID 및 암호)에서 iPhone 암호를 설정하세요. 설정하면 Face ID나 Touch ID로도 잠금을 해제할 수 있습니다.\n\n잠긴 메모와 폴더는 삭제되지 않으며, 암호를 설정하면 다시 열 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar bloqueios, defina um código no iPhone em Ajustes > Face ID e Código (ou Touch ID e Código). Depois, você também poderá desbloquear com o Face ID ou o Touch ID.\n\nNotas e pastas bloqueadas não são excluídas, e você poderá abri-las novamente depois de definir um código."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如要使用鎖定功能，請前往「設定」>「Face ID 與密碼」（或「Touch ID 與密碼」）為 iPhone 設定密碼。設定後，也可以使用 Face ID 或 Touch ID 解除鎖定。\n\n已鎖定的記事和資料夾不會被刪除，設定密碼後就能再次開啟。"
          }
        }
      }
    },
