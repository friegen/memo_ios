	<string>$(ADMOB_APP_ID)</string>
	<key>AdMobBannerMainID</key>
	<string>$(ADMOB_BANNER_MAIN_ID)</string>
	<key>AdMobBannerEditorID</key>
	<string>$(ADMOB_BANNER_EDITOR_ID)</string>
	<key>AdMobAppOpenID</key>
