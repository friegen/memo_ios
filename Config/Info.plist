		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<!-- AdMob（広告）。ID はビルドの設定（Debug はテスト用、Release は本物）。project.xcproj の ADMOB_* -->
